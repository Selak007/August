{
  "manifest_version": 3,
  "name": "August — Voice Browser Agent",
  "version": "1.0.0",
  "description": "Completely local, private, voice-controlled Chrome assistant. Zero API cost, no backend needed.",

  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "windows",
    "storage",
    "sidePanel",
    "tts"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "August Voice Agent",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "open_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Open August Voice Assistant Side Panel"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
